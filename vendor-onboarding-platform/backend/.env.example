ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://vendor:vendor@localhost:5432/vendor_onboarding
REDIS_URL=redis://localhost:6379/0

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (and must not be the default) whenever ENVIRONMENT is not local/test.
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
